POSTGRES_USER=zipflow
POSTGRES_PASSWORD=ChangeThisLocalPassword!1
POSTGRES_DB=ZipFlow

# Symmetric JWT signing key. At least 32 characters. Generate a fresh one per
# deployment — never reuse this sample value.
JWT_SIGNING_KEY=local-development-only-zipflow-signing-key-change-me-2026

# Exact origin the SPA is served from (scheme + host, no trailing slash).
# There is no wildcard fallback: this must match the Cloudflare Pages domain
# in a real deployment, or the browser blocks every call before it reaches
# the API. Add CORS_ALLOWED_ORIGIN_1 style entries as Cors__AllowedOrigins__1
# in docker-compose.yml if more than one origin is needed.
CORS_ALLOWED_ORIGIN=http://localhost:5173
